@using NuGet.Packaging
@model ProductVm
<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-3">
            <h2 class="text-white py-2">
                @{
                    var title = Model.Product.Id == 0 ? "Create" : "Update";
                }
                @title Product
            </h2>
            <hr/>
        </div>
        <div asp-validation-summary="All"></div>
        <input asp-for="Product.Id" type="hidden"/>
        @{
            var columns = ProductVm.GetAllProperties();
            foreach (var col in columns)
            {
                if (col.Name == "Id")
                {
                    continue;
                }

                switch (col.Name)
                {
                    case "Id" or "CategoryId" or "Category":
                        break;
                    case "CategoryList":
                        <div class="row pb-2 p-1">
                            <label class="pb-2" for="@col.Name">Category</label>
                            <select asp-for="Product.CategoryId" asp-items="@Model?.CategoryList" class="form-control border-0 shadow">
                                <option disabled selected>-- Select Category --</option>
                            </select>
                        </div>
                        break;
                    default:
                        <div class="row pb-2 p-1">
                            <label class="pb-2" for="@col.Name">@col.Name</label>
                            <input type="text" name="@col.Name" id="@col.Name" class="form-control border-0 shadow" value="@Model?.GetType().GetProperty(col.Name)?.GetValue(Model, null)"/>
                            <span class="text-danger" id="validation_@col.Name"></span>
                        </div>
                        break;
                }
            }
        }

        <div class="row pt-3">
            <div class="col-6">
                <button type="submit" class="btn btn-primary form-control">@title Product</button>
            </div>
            <div class="col-6">
                <a class="btn btn-secondary border form-control" asp-controller="Product" asp-action="Index">Back To List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts
{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}