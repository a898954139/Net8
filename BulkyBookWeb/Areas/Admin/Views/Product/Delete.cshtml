@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Bulky.Models.Models.Product
<form method="post">
    <input asp-for="Id" hidden/>
    <div class="border p-3 mt-4">
        <div class="row pb-3">
            <h2>Delete Product</h2>
            <hr/>
        </div>
        <div asp-validation-summary="All"></div>
        @{
            var columns = typeof(Bulky.Models.Models.Product).GetProperties();
            foreach (var col in columns)
            {
                if (col.Name == "Id")
                    continue;

                <div class="row pb-2 p-1">
                    <label class="pb-2" for="@col.Name">@col.Name</label>
                    <input type="text" name="@col.Name" id="@col.Name" class="form-control" value="@Model?.GetType().GetProperty(col.Name)?.GetValue(Model, null)"/>
                    <span class="text-danger" id="validation_@col.Name"></span>
                </div>
            }
        }

        <div class="row pt-3">
            <div class="col-6">
                <button type="submit" class="btn btn-primary form-control">Update Product</button>
            </div>
            <div class="col-6">
                <a class="btn btn-secondary border form-control" asp-controller="Product" asp-action="Index">Back To List</a>
            </div>
        </div>
    </div>
</form>

@section Scripts
{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}