@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<Bulky.Models.Models.Product>
<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary-emphasis">
                Product List
            </h2>
        </div>
        <div class="col-4 text-end">
            <a class="btn btn-primary" asp-controller="Product" asp-action="Upsert">
                <i class="bi bi-plus-circle-fill"></i> Add New Product
            </a>
        </div>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            @{
                var columns = typeof(Product).GetProperties();
                foreach (var col in columns)
                {
                    <th>@col.Name</th>
                }
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                @foreach (var col in columns)
                {
                    <td>@col.GetValue(product)</td>
                }
                <td>
                    <div class="w-75 btn-group" role="group">
                        <a asp-controller="Product" asp-action="Upsert" asp-route-Id="@product.Id" class="btn btn-primary me-2">
                            <i class="bi bi-pen-fill"></i> Edit
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-Id = "@product.Id" class="btn btn-danger me-2">
                            <i class="bi bi-trash-fill"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>